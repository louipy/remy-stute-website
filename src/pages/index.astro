---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import IndustriasServidas from "@components/IndustriasServidas.astro";
import VentajaCompetitiva from "@components/VentajaCompetitiva.astro";
import ContactoCTA from "@components/ContactoCTA.astro";

const title = "Remy & Stute C.A. — Materia Prima Industrial Venezuela";
const description =
  "Importador venezolano de materia prima industrial con 30 años de trayectoria. Representante exclusivo de Addcon, Yipin Pigmentos y Minerales Industriales en Venezuela.";
---

<BaseLayout title={title} description={description} active="inicio">
  <Hero />
  <IndustriasServidas />
  <VentajaCompetitiva />
  <ContactoCTA />
</BaseLayout>
