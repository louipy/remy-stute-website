---
/**
 * Página de contacto — brief técnico.
 * ContactSection genera idempotencyKey al montar (R3), monta Turnstile y
 * hace submit a /api/contacto (orden Turnstile → Zod → n8n, R4).
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactSection from "@components/ContactSection.astro";
---

<BaseLayout
  title="Cotización Materia Prima Industrial Venezuela — Remy & Stute C.A."
  description="Solicite un diagnóstico técnico y cotización de materia prima industrial. Respuesta en menos de 4 horas hábiles por WhatsApp, email y teléfono."
  active="contacto"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ContactPage",
          "@id": "https://remyvenezuela.com/contacto#webpage",
          "url": "https://remyvenezuela.com/contacto",
          "name": "Cotización Materia Prima Industrial Venezuela — Remy & Stute C.A.",
          "isPartOf": { "@id": "https://remyvenezuela.com/#website" },
          "about": { "@id": "https://remyvenezuela.com/#business" }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://remyvenezuela.com" },
            { "@type": "ListItem", "position": 2, "name": "Contacto y Cotización", "item": "https://remyvenezuela.com/contacto" }
          ]
        }
      ]
    })} />
  </Fragment>
  <ContactSection />
</BaseLayout>
