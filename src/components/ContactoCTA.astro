---
/* Contacto CTA — Home sección 05. Réplica de design-reference. */
const pasos = [
  { n: "01", title: "Formulario técnico", desc: "Envía formulario con la información solicitada." },
  { n: "02", title: "Respuesta <4h", desc: "Nuestro equipo de comercio revisará la solicitud y se pondrá en contacto con usted." },
  { n: "03", title: "Cotización", desc: "Precio con vigencia 15 días, fecha de despacho, condiciones de pago." },
];
---

<section class="cta">
  <div class="wrap">
    <div class="cta__card reveal">
      <div class="cta__main">
        <p class="eyebrow">
          <span class="num">05</span>
          <span class="line"></span>
          <span>Próximo paso · cotización técnica</span>
        </p>
        <h2 class="cta__title">
          Cuéntenos qué necesita su planta.<br />
          <span class="g">Le contactaremos en menos de 4h.</span>
        </h2>
        <p class="cta__lead">
          Indique producto de interés y volumen estimado. Recibirá cotización
          con vigencia 15 días y propuesta de muestra previa al despacho.
        </p>
        <div class="cta__actions">
          <a href="/contacto" class="btn btn--primary">
            Solicitar cotización
            <i data-lucide="arrow-right"></i>
          </a>
          <a
            href="https://wa.me/582129936508"
            class="btn btn--outline"
            target="_blank"
            rel="noopener"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.557 4.126 1.533 5.874L0 24l6.302-1.51A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.368l-.359-.213-3.722.892.924-3.617-.234-.371A9.818 9.818 0 012.18 12C2.18 6.57 6.57 2.18 12 2.18c5.43 0 9.818 4.39 9.818 9.82 0 5.43-4.388 9.818-9.818 9.818z"/>
            </svg>
            +58 212 993·65·08
          </a>
        </div>
      </div>

      <aside class="cta__flow">
        <p class="cta__flow-title">Flujo de cotización · 3 pasos</p>
        {pasos.map((p, i) => (
          <div class="cta__step" data-last={i === pasos.length - 1}>
            <span class="cta__step-num">{p.n}</span>
            <div>
              <div class="cta__step-name">{p.title}</div>
              <div class="cta__step-desc">{p.desc}</div>
            </div>
          </div>
        ))}
      </aside>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--cream); padding: 88px 0; }
  .cta__card {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    background: var(--white);
    border: 1px solid var(--border-2);
  }
  .cta__main { padding: 56px 48px; border-right: 1px solid var(--border-2); }
  .cta__title {
    margin: 20px 0;
    font-family: var(--display);
    font-size: clamp(34px, 3.6vw, 48px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .cta__title .g { color: var(--green); }
  .cta__lead {
    max-width: 520px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text);
    margin-bottom: 32px;
  }
  .cta__actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .cta__flow { background: var(--cream-2); padding: 56px 48px; }
  .cta__flow-title {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .cta__step {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 6px 0;
    padding-bottom: 26px;
    margin-bottom: 26px;
    border-bottom: 1px solid var(--border);
  }
  .cta__step[data-last="true"] { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .cta__step-num { font-family: var(--num); font-size: 36px; line-height: 1; color: var(--green); }
  .cta__step-name {
    font-family: var(--display);
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
  }
  .cta__step-desc { margin-top: 5px; font-size: 14px; line-height: 1.6; color: var(--text); }

  @media (max-width: 880px) {
    .cta__card { grid-template-columns: 1fr; }
    .cta__main { border-right: 0; border-bottom: 1px solid var(--border-2); }
    .cta__main, .cta__flow { padding: 40px 28px; }
  }
</style>
