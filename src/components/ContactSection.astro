---
import LogoNavbar from '../assets/logo-navbar-2.svg?raw';
import { INDUSTRIAS_VALIDAS } from '../lib/schemas/contacto';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const hasTurnstile = Boolean(siteKey);
---

<!-- ── CABECERA OSCURA ──────────────────────────────────────────────── -->
<section class="ct-head">
  <div class="wrap">
    <p class="ct-eyebrow">Contacto</p>
    <h1 class="ct-title">
      Cuéntenos qué necesita su planta.
      <span class="g">Respuesta en &lt;24h hábiles.</span>
    </h1>
  </div>
</section>

<!-- ── CUERPO: info + formulario multi-paso ────────────────────────── -->
<section class="ct-body">
  <div class="wrap ct-grid">

    <!-- Columna izquierda: datos de contacto -->
    <aside class="ct-aside">
      <div class="ct-sep"></div>
      <p class="ct-aside-eyebrow">Contáctanos</p>
      <h2 class="ct-aside-title">Hablemos de<br>tu operación.</h2>
      <p class="ct-aside-sub">
        Cuéntanos qué necesitas y te respondemos antes de 24 horas hábiles.
      </p>

      <div class="ct-details">
        <a href="https://wa.me/584122600046" class="ct-detail" target="_blank" rel="noopener">
          <span class="ct-detail-label">WhatsApp directo</span>
          <span class="ct-detail-value">+58 412-260-0046</span>
        </a>
        <a href="mailto:info@remyvenezuela.com" class="ct-detail">
          <span class="ct-detail-label">Correo electrónico</span>
          <span class="ct-detail-value">info@remyvenezuela.com</span>
        </a>
      </div>

      <div class="ct-badge">
        <span class="ct-badge-dot"></span>
        Respondemos antes de 24h hábiles
      </div>
    </aside>

    <!-- Columna derecha: formulario multi-paso -->
    <div class="ct-formwrap">
      <form id="msfContainer" class="msf-card" novalidate>

        <!-- ── PASO 1: Filtro de calificación ── -->
        <div id="msf-step1" class="msf-step">
          <p class="msf-q" id="msf-step1-q">¿Es su empresa una industria constituida?</p>
          <div class="msf-opts" role="radiogroup" aria-labelledby="msf-step1-q">
            <label class="msf-opt">
              <input type="radio" name="step1" value="Sí, somos empresa industrial con RIF activo" class="sr-only">
              Sí, somos empresa industrial con RIF activo
            </label>
            <label class="msf-opt">
              <input type="radio" name="step1" value="No" class="sr-only">
              No
            </label>
          </div>
        </div>

        <!-- ── PANTALLA DE CIERRE ── -->
        <div id="msf-close" class="msf-screen" style="display:none;">
          <div class="msf-close-logo">
            <span class="msf-close-logo-svg" set:html={LogoNavbar}></span>
            <span class="msf-close-logo-text">Rem<span class="brand-y">y</span><span class="ampersand">&amp;</span> Stute</span>
          </div>
          <h3 class="msf-close-title">¡Gracias por su interés!</h3>
          <p class="msf-close-body">
            Nuestros productos están dirigidos exclusivamente al sector industrial.
            Gracias por su interés.
          </p>
          <hr class="msf-close-sep">
          <p class="msf-close-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            Su respuesta no será enviada a Remy &amp; Stute.
          </p>
          <button type="button" class="msf-btn-ghost" id="msf-back-to-hero">
            Volver al inicio
          </button>
        </div>

        <!-- ── PASOS 2–5 ── -->
        <div id="msf-main" style="display:none;">
          <div class="msf-header">
            <button type="button" class="msf-back" id="msfBack">← Atrás</button>
            <span class="msf-count" id="msfCount"></span>
          </div>
          <div class="msf-progress">
            <div class="msf-progress-fill" id="msfFill"></div>
          </div>

          <!-- Paso 2: Empresa -->
          <div id="msf-step2" class="msf-panel" style="display:none;">
            <p class="msf-q">Nombre de la empresa</p>
            <input type="text" id="msf-empresa" class="msf-input" autocomplete="organization">
            <button type="button" class="msf-btn" id="btn-s2" disabled>Continuar</button>
          </div>

          <!-- Paso 3: Cargo -->
          <div id="msf-step3" class="msf-panel" style="display:none;">
            <p class="msf-q" id="msf-step3-q">¿Cuál es su cargo?</p>
            <div class="msf-opts" role="radiogroup" aria-labelledby="msf-step3-q">
              <label class="msf-opt"><input type="radio" name="cargo" value="Jefe/Gerente de Compras" class="sr-only">Jefe/Gerente de Compras</label>
              <label class="msf-opt"><input type="radio" name="cargo" value="Gerente de Planta" class="sr-only">Gerente de Planta</label>
              <label class="msf-opt"><input type="radio" name="cargo" value="Ingeniero de Procesos" class="sr-only">Ingeniero de Procesos</label>
              <label class="msf-opt"><input type="radio" name="cargo" value="Formulador / Laboratorio" class="sr-only">Formulador / Laboratorio</label>
              <label class="msf-opt"><input type="radio" name="cargo" value="Director General / Dueño" class="sr-only">Director General / Dueño</label>
              <label class="msf-opt"><input type="radio" name="cargo" value="Nutricionista / Formulador Feed" class="sr-only">Nutricionista / Formulador Feed</label>
              <label class="msf-opt"><input type="radio" name="cargo" value="Otro" class="sr-only">Otro</label>
            </div>
            <div id="cargo-otro-wrap" style="display:none; margin-top:10px;">
              <label class="sr-only" for="cargo-otro-input">Especifique su cargo</label>
              <input type="text" id="cargo-otro-input" class="msf-input" placeholder="Especifique su cargo">
            </div>
            <button type="button" class="msf-btn" id="btn-s3" disabled>Continuar</button>
          </div>

          <!-- Paso 4: Industria -->
          <div id="msf-step4" class="msf-panel" style="display:none;">
            <p class="msf-q" id="msf-step4-q">¿En qué industria opera su empresa?</p>
            <div class="msf-opts" role="radiogroup" aria-labelledby="msf-step4-q">
              {INDUSTRIAS_VALIDAS.map((ind) => (
                <label class="msf-opt"><input type="radio" name="industria" value={ind} class="sr-only" />{ind}</label>
              ))}
            </div>
            <button type="button" class="msf-btn" id="btn-s4" disabled>Continuar</button>
          </div>

          <!-- Paso 5: Contacto + envío -->
          <div id="msf-step5" class="msf-panel" style="display:none;">
            <p class="msf-q">Información de contacto</p>
            <p class="msf-sub">
              Remy &amp; Stute C.A. utilizará sus datos para enviarle la
              documentación técnica solicitada y contactarlo con información
              comercial sobre materias primas industriales.
            </p>
            <div class="msf-field">
              <label class="msf-label" for="msf-email">Correo electrónico</label>
              <input type="email" id="msf-email" class="msf-input" autocomplete="email">
            </div>
            <div class="msf-field">
              <label class="msf-label" for="msf-nombre">Nombre completo</label>
              <input type="text" id="msf-nombre" class="msf-input" autocomplete="name">
            </div>
            <div class="msf-field">
              <label class="msf-label" for="msf-telefono">Teléfono / WhatsApp</label>
              <input type="tel" id="msf-telefono" class="msf-input" autocomplete="tel">
            </div>
            {hasTurnstile && (
              <div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark" style="margin-top:1rem;"></div>
            )}
            <p class="msf-err" id="msf-global-err" role="alert" aria-live="assertive"></p>
            <button type="submit" class="msf-btn" id="btn-s5" disabled>Enviar formulario</button>
            <p class="msf-footer-note">
              Tu información es confidencial. Solo la usa el equipo de Remy &amp; Stute.
            </p>
          </div>

        </div><!-- end msf-main -->

        <!-- ── PANTALLA DE ÉXITO ── -->
        <div id="msf-success" class="msf-screen" style="display:none;">
          <div class="msf-close-logo">
            <span class="msf-close-logo-svg" set:html={LogoNavbar}></span>
            <span class="msf-close-logo-text">Rem<span class="brand-y">y</span><span class="ampersand">&amp;</span> Stute</span>
          </div>
          <h3 class="msf-success-title">Solicitud recibida</h3>
          <p class="msf-close-body">
            Nuestro departamento técnico se pondrá en contacto con usted
            en menos de 24 horas hábiles.
          </p>
          <p class="msf-close-body msf-success-wa">
            Si desea comunicarse de inmediato, escríbanos por
            <a href="https://wa.me/584122600046?text=Hola%20requiero%20información"
               class="msf-success-wa-link"
               target="_blank"
               rel="noopener">WhatsApp</a>.
          </p>
          <hr class="msf-close-sep">
          <p class="msf-close-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C8F04D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            Su información ha sido enviada a Remy &amp; Stute.
          </p>
        </div>

      </form><!-- end msf-card -->
    </div>

  </div>
</section>

<style>
  /* ── Cabecera oscura ── */
  .ct-head {
    background: var(--ink);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 56px 0 32px;
  }
  .ct-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lime);
  }
  .ct-title {
    margin-top: 12px;
    max-width: 980px;
    font-family: var(--display);
    font-size: clamp(34px, 4vw, 56px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: #fff;
  }
  .ct-title .g { color: #C8F04D; }

  /* ── Cuerpo ── */
  .ct-body { background: var(--cream-2); padding: 64px 0 96px; }
  .ct-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 72px;
    align-items: start;
  }

  /* ── Aside izquierdo ── */
  .ct-aside { position: sticky; top: 96px; }
  .ct-sep { width: 40px; height: 2px; background: var(--green); border-radius: 2px; margin-bottom: 20px; }
  .ct-aside-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .ct-aside-title {
    font-family: var(--display);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 800;
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: 12px;
    letter-spacing: -0.02em;
  }
  .ct-aside-sub {
    font-size: 15px;
    color: var(--text);
    line-height: 1.7;
    margin-bottom: 32px;
    max-width: 340px;
  }

  .ct-details { display: flex; flex-direction: column; }
  .ct-detail {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 14px 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
  }
  .ct-detail:last-child { border-bottom: 1px solid var(--border); }
  .ct-detail-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ct-detail-value { font-size: 15px; color: var(--ink); font-weight: 500; transition: color 150ms; }
  a.ct-detail:hover .ct-detail-value { color: var(--green); }

  .ct-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    padding: 8px 16px;
    background: rgba(0,102,51,0.06);
    border: 1px solid rgba(0,102,51,0.15);
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--green);
    letter-spacing: 0.08em;
  }
  .ct-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    flex-shrink: 0;
    animation: ctpulse 2s ease-in-out infinite;
  }
  @keyframes ctpulse {
    0%,100% { opacity:1; transform:scale(1); }
    50%      { opacity:.5; transform:scale(.8); }
  }

  /* ── Tarjeta del formulario ── */
  .msf-card {
    background: #111814;
    border: 1px solid rgba(200,240,77,0.12);
    border-radius: 8px;
    padding: 2rem;
  }

  /* Barra de progreso */
  .msf-progress {
    height: 3px;
    background: rgba(200,240,77,0.12);
    border-radius: 2px;
    margin-bottom: 1.5rem;
    overflow: hidden;
  }
  .msf-progress-fill {
    height: 100%;
    background: #C8F04D;
    border-radius: 2px;
    width: 0%;
    transition: width 300ms ease;
  }

  /* Header (atrás + contador) */
  .msf-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .msf-back {
    background: none;
    border: none;
    color: rgba(240,237,230,0.5);
    font-family: var(--body);
    font-size: 14px;
    cursor: pointer;
    padding: 0;
    transition: color 150ms;
  }
  .msf-back:hover { color: #F0EDE6; }
  .msf-count {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: rgba(240,237,230,0.4);
  }

  /* Pregunta */
  .msf-q {
    font-family: var(--display);
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #F0EDE6;
    margin-bottom: 1.25rem;
    line-height: 1.3;
  }
  .msf-sub {
    font-size: 13px;
    color: rgba(240,237,230,0.55);
    line-height: 1.65;
    margin-top: -0.75rem;
    margin-bottom: 1.5rem;
  }

  /* Tarjetas de opción */
  .msf-opts { display: flex; flex-direction: column; }
  .msf-opt {
    display: block;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(200,240,77,0.12);
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 10px;
    color: #F0EDE6;
    font-size: 15px;
    cursor: pointer;
    transition: all 200ms ease;
    user-select: none;
  }
  .msf-opt:last-child { margin-bottom: 0; }
  .msf-opt:hover { border-color: rgba(200,240,77,0.4); }
  .msf-opt:has(input:checked) {
    border-color: #C8F04D;
    background: rgba(200,240,77,0.08);
  }
  /* Foco de teclado visible en la opción (el radio real está sr-only) */
  .msf-opt:focus-within {
    border-color: rgba(200,240,77,0.6);
    outline: 2px solid rgba(200,240,77,0.5);
    outline-offset: 2px;
  }

  /* Visualmente oculto pero accesible y enfocable (no display:none) */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Input de texto */
  .msf-input {
    width: 100%;
    padding: 12px 16px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(200,240,77,0.12);
    border-radius: 4px;
    font-family: var(--body);
    font-size: 14px;
    color: #F0EDE6;
    outline: none;
    transition: border-color 200ms, background 200ms;
    -webkit-appearance: none;
    appearance: none;
  }
  .msf-input:focus {
    border-color: rgba(200,240,77,0.45);
    background: rgba(255,255,255,0.06);
  }

  /* Campo con label */
  .msf-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
  .msf-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(240,237,230,0.45);
  }

  /* Botón continuar / enviar */
  .msf-btn {
    width: 100%;
    background: #C8F04D;
    color: #0A0F0D;
    border: none;
    border-radius: 4px;
    padding: 14px;
    font-family: var(--body);
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    margin-top: 1.5rem;
    letter-spacing: 0.01em;
    transition: background 200ms;
  }
  .msf-btn:hover:not(:disabled) { background: #d8ff5a; }
  .msf-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* Botón fantasma (pantalla de cierre) */
  .msf-btn-ghost {
    background: transparent;
    border: 1px solid rgba(240,237,230,0.2);
    border-radius: 4px;
    padding: 12px 24px;
    color: rgba(240,237,230,0.7);
    font-family: var(--body);
    font-size: 14px;
    cursor: pointer;
    transition: border-color 200ms, color 200ms;
  }
  .msf-btn-ghost:hover { border-color: rgba(240,237,230,0.5); color: #F0EDE6; }

  .msf-footer-note {
    font-size: 12px;
    color: rgba(240,237,230,0.3);
    text-align: center;
    font-style: italic;
    margin-top: 12px;
  }

  .msf-err {
    font-size: 12px;
    color: #ff8080;
    min-height: 1em;
    margin-top: 8px;
  }

  /* Pantallas especiales (cierre / éxito) */
  .msf-screen { text-align: center; padding: 2rem 1rem; }
  .msf-screen-title {
    font-family: var(--display);
    font-size: 24px;
    font-weight: 700;
    color: #F0EDE6;
    margin-bottom: 1rem;
    letter-spacing: 0.01em;
  }
  .msf-screen-text {
    font-size: 14px;
    color: rgba(240,237,230,0.6);
    line-height: 1.7;
    max-width: 360px;
    margin: 0 auto 1.5rem;
  }
  .msf-screen-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    margin: 0 auto 1.25rem;
  }
  .msf-screen-icon--close { background: rgba(255,255,255,0.06); color: rgba(240,237,230,0.6); }
  .msf-screen-icon--ok    { background: rgba(200,240,77,0.12); border: 1px solid rgba(200,240,77,0.3); color: #C8F04D; }

  /* Pantalla de cierre — nuevo diseño */
  .msf-close-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-bottom: 0;
  }
  .msf-close-logo-svg :global(svg) {
    height: 60px;
    width: auto;
  }
  .msf-close-logo-text {
    font-family: 'Galano Grotesque', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -2px;
    color: #FFFFFF;
    white-space: nowrap;
  }
  .msf-close-title {
    font-family: var(--display);
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 700;
    color: #F0EDE6;
    margin-top: 1.5rem;
    margin-bottom: 0;
    letter-spacing: 0.01em;
  }
  .msf-close-body {
    font-family: var(--body);
    font-size: 14px;
    color: #8A9488;
    line-height: 1.6;
    max-width: 350px;
    margin: 0.75rem auto 0;
  }
  .msf-close-sep {
    border: none;
    border-top: 1px solid rgba(200,240,77,0.15);
    max-width: 300px;
    margin: 1.5rem auto;
  }
  .msf-close-note {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    justify-content: center;
    font-size: 12px;
    color: rgba(138,148,136,0.6);
    margin: 0 0 1.5rem;
  }

  /* Pantalla de éxito */
  .msf-success-title {
    font-family: var(--num);
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 700;
    color: #F0EDE6;
    margin-top: 1.5rem;
    margin-bottom: 0;
    text-align: center;
  }
  .msf-success-wa {
    margin-top: 0.5rem !important;
  }
  .msf-success-wa-link {
    color: #C8F04D;
    text-decoration: none;
  }
  .msf-success-wa-link:hover { text-decoration: underline; }

  /* Responsive */
  @media (max-width: 960px) {
    .ct-grid { grid-template-columns: 1fr; gap: 40px; }
    .ct-aside { position: static; }
  }
  @media (max-width: 560px) {
    .msf-card { padding: 1.5rem; }
    .ct-body { padding: 40px 0 64px; }
  }
</style>

<script is:inline define:vars={{ hasTurnstile }}>
  if (hasTurnstile) {
    var ts = document.createElement('script');
    ts.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    ts.async = true;
    ts.defer = true;
    document.head.appendChild(ts);
  }
</script>

<script is:inline>
(function () {
  var idempotencyKey = crypto.randomUUID();
  var TOTAL = 5;
  var currentStep = 1;
  var formData = {
    empresaConstituida: '',
    empresa: '',
    cargo: '',
    industria: '',
    email: '',
    nombre: '',
    telefono: '',
    idempotencyKey: idempotencyKey,
  };

  var step1El = document.getElementById('msf-step1');
  var closeEl = document.getElementById('msf-close');
  var mainEl  = document.getElementById('msf-main');
  var okEl    = document.getElementById('msf-success');
  var fillEl  = document.getElementById('msfFill');
  var countEl = document.getElementById('msfCount');
  var backBtn = document.getElementById('msfBack');

  function updateProgress(n) {
    fillEl.style.width = (n / TOTAL * 100) + '%';
    countEl.textContent = n + '/' + TOTAL;
  }

  function animOut(el, dir) {
    el.style.transition = 'opacity 200ms ease, transform 200ms ease';
    el.style.opacity = '0';
    el.style.transform = 'translateX(' + (dir > 0 ? '-' : '') + '20px)';
  }

  function animIn(el, dir) {
    el.style.opacity = '0';
    el.style.transform = 'translateX(' + (dir > 0 ? '' : '-') + '20px)';
    el.style.transition = '';
    el.style.display = 'block';
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        el.style.transition = 'opacity 200ms ease, transform 200ms ease';
        el.style.opacity = '1';
        el.style.transform = 'translateX(0)';
      });
    });
  }

  function clearAnim(el) {
    el.style.transition = '';
    el.style.opacity = '';
    el.style.transform = '';
  }

  function goToStep(n) {
    var dir = n >= currentStep ? 1 : -1;
    var prev = currentStep;

    function showN() {
      currentStep = n;
      if (n === 1) {
        mainEl.style.display = 'none';
        animIn(step1El, -1);
      } else {
        if (prev === 1) {
          step1El.style.display = 'none';
          mainEl.style.display = 'block';
        }
        updateProgress(n);
        animIn(document.getElementById('msf-step' + n), dir);
      }
    }

    if (prev === 1) {
      animOut(step1El, 1);
      setTimeout(function () {
        step1El.style.display = 'none';
        clearAnim(step1El);
        showN();
      }, 200);
    } else {
      var prevEl = document.getElementById('msf-step' + prev);
      animOut(prevEl, dir);
      setTimeout(function () {
        prevEl.style.display = 'none';
        clearAnim(prevEl);
        showN();
      }, 200);
    }
  }

  backBtn.addEventListener('click', function () { goToStep(currentStep - 1); });

  document.getElementById('msf-back-to-hero').addEventListener('click', function (e) {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  /* ── Paso 1 ── (change = funciona con click de ratón y con teclado) */
  document.querySelectorAll('#msf-step1 input[name="step1"]').forEach(function (input) {
    input.addEventListener('change', function () {
      formData.empresaConstituida = input.value;
      if (input.value === 'No') {
        setTimeout(function () {
          step1El.style.display = 'none';
          closeEl.style.display = 'block';
        }, 250);
      } else {
        setTimeout(function () { goToStep(2); }, 250);
      }
    });
  });

  // Enter en un campo de texto intermedio activa su botón "Continuar" (si está
  // habilitado). El paso 5 ya envía por submisión implícita del <form>.
  function enterAvanza(input, btn) {
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        if (!btn.disabled) btn.click();
      }
    });
  }

  /* ── Paso 2: empresa ── */
  var s2input = document.getElementById('msf-empresa');
  var btnS2   = document.getElementById('btn-s2');
  s2input.addEventListener('input', function () { btnS2.disabled = s2input.value.trim().length < 3; });
  btnS2.addEventListener('click', function () { formData.empresa = s2input.value.trim(); goToStep(3); });
  enterAvanza(s2input, btnS2);

  /* ── Paso 3: cargo ── */
  var btnS3        = document.getElementById('btn-s3');
  var cargoOtroW   = document.getElementById('cargo-otro-wrap');
  var cargoOtroInp = document.getElementById('cargo-otro-input');

  document.querySelectorAll('#msf-step3 input[name="cargo"]').forEach(function (input) {
    input.addEventListener('change', function () {
      if (input.value === 'Otro') {
        cargoOtroW.style.display = 'block';
        cargoOtroInp.focus();
        validateCargo();
      } else {
        cargoOtroW.style.display = 'none';
        btnS3.disabled = false;
      }
    });
  });

  cargoOtroInp.addEventListener('input', validateCargo);
  enterAvanza(cargoOtroInp, btnS3);

  function validateCargo() {
    var checked = document.querySelector('#msf-step3 input[name="cargo"]:checked');
    if (!checked) { btnS3.disabled = true; return; }
    btnS3.disabled = checked.value === 'Otro'
      ? cargoOtroInp.value.trim().length === 0
      : false;
  }

  btnS3.addEventListener('click', function () {
    var checked = document.querySelector('#msf-step3 input[name="cargo"]:checked');
    if (!checked) return;
    formData.cargo = checked.value === 'Otro' ? cargoOtroInp.value.trim() : checked.value;
    goToStep(4);
  });

  /* ── Paso 4: industria ── */
  var btnS4 = document.getElementById('btn-s4');
  document.querySelectorAll('#msf-step4 input[name="industria"]').forEach(function (input) {
    input.addEventListener('change', function () { btnS4.disabled = false; });
  });
  btnS4.addEventListener('click', function () {
    var checked = document.querySelector('#msf-step4 input[name="industria"]:checked');
    if (!checked) return;
    formData.industria = checked.value;
    goToStep(5);
  });

  /* ── Paso 5: contacto + envío ── */
  var s5email    = document.getElementById('msf-email');
  var s5nombre   = document.getElementById('msf-nombre');
  var s5telefono = document.getElementById('msf-telefono');
  var btnS5      = document.getElementById('btn-s5');
  var globalErr  = document.getElementById('msf-global-err');

  function validateS5() {
    var emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s5email.value.trim());
    btnS5.disabled = !(emailOk && s5nombre.value.trim() && s5telefono.value.trim());
  }

  [s5email, s5nombre, s5telefono].forEach(function (el) {
    el.addEventListener('input', validateS5);
  });

  // B2: tras un error, el token de Turnstile ya se consumió (single-use);
  // resetearlo evita que el reintento falle con 403 por token gastado.
  function resetTurnstile() {
    if (window.turnstile && typeof window.turnstile.reset === 'function') {
      try { window.turnstile.reset(); } catch (_) {}
    }
  }

  function submitError(msg) {
    if (globalErr) globalErr.textContent = msg;
    resetTurnstile();
    btnS5.disabled = false;
    btnS5.textContent = 'Enviar formulario';
  }

  async function submitForm() {
    formData.email    = s5email.value.trim().toLowerCase();
    formData.nombre   = s5nombre.value.trim();
    formData.telefono = s5telefono.value.trim();

    var turnstileInput = document.querySelector('[name="cf-turnstile-response"]');
    var turnstile_token = turnstileInput ? turnstileInput.value : '';

    btnS5.disabled = true;
    btnS5.textContent = 'Enviando…';
    if (globalErr) globalErr.textContent = '';

    // Shape acoplado a GenerateLeadEvent en src/lib/analytics/dataLayer.ts.
    // (push inline: este script es is:inline y no puede importar el módulo tipado.)
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'generate_lead',
      event_id: formData.idempotencyKey,
      form_id: 'contacto',
      lead_empresa: formData.empresa,
      lead_industria: formData.industria,
    });

    try {
      var payload = Object.assign({}, formData, { turnstile_token: turnstile_token });
      var res = await fetch('/api/contacto', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        var step5El = document.getElementById('msf-step5');
        step5El.style.transition = 'opacity 200ms ease';
        step5El.style.opacity = '0';
        setTimeout(function () {
          step5El.style.display = 'none';
          mainEl.style.display = 'none';
          okEl.style.opacity = '0';
          okEl.style.display = 'block';
          setTimeout(function () {
            okEl.style.transition = 'opacity 400ms ease';
            okEl.style.opacity = '1';
          }, 30);
        }, 200);
      } else {
        var json = await res.json().catch(function () { return {}; });
        var errMsg = 'Error al enviar. Por favor, intente de nuevo.';
        if (res.status === 403) {
          errMsg = 'Error de verificación. Recargue la página e intente de nuevo.';
        } else if (res.status === 422 && json.fieldErrors) {
          var first = Object.values(json.fieldErrors).flat()[0];
          if (first) errMsg = first;
        }
        submitError(errMsg);
      }
    } catch (_) {
      submitError('Error de conexión. Verifique su conexión e intente de nuevo.');
    }
  }

  // El form es semántico: Enter envía. Según el paso, avanza o ejecuta el submit final.
  document.getElementById('msfContainer').addEventListener('submit', function (e) {
    e.preventDefault();
    if (currentStep === 5) {
      if (!btnS5.disabled) submitForm();
      return;
    }
    var stepBtn = document.getElementById('btn-s' + currentStep);
    if (stepBtn && !stepBtn.disabled) stepBtn.click();
  });
})();
</script>
