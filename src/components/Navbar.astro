---
import LogoNavbar from "../assets/logo-navbar-2.svg?raw";

interface Props {
  active?: "inicio" | "productos" | "nosotros" | "contacto";
}
const { active } = Astro.props;

const links = [
  { key: "inicio", label: "Inicio", href: "/" },
  { key: "productos", label: "Productos", href: "/productos" },
  { key: "nosotros", label: "Nosotros", href: "/nosotros" },
  { key: "contacto", label: "Contacto", href: "/contacto" },
];
---

<header class="site-header" id="siteHeader">
  <div class="wrap">
    <a href="/" class="brand" aria-label="Remy & Stute — inicio">
      <span class="brand-logo" set:html={LogoNavbar}></span>
      <span class="brand-navbar-text">Rem<span class="brand-y">y</span><span class="ampersand">&amp;</span> Stute <span class="venezuela">Venezuela</span></span>
    </a>

    <nav class="nav" aria-label="Principal">
      {links.map((l) => (
        <a href={l.href} aria-current={active === l.key ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="header-right">
      <a href="tel:+582129936508" class="header-phone">
        <i data-lucide="message-circle"></i>
        +58 212 993·65·08
      </a>
      <a href="/contacto" class="btn btn--primary">
        Solicitar cotización
        <i data-lucide="arrow-right"></i>
      </a>
      <button class="burger" id="burger" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer-overlay" id="drawerOverlay"></div>
<aside class="drawer" id="drawer" aria-label="Menú">
  <button class="drawer-close" id="drawerClose" aria-label="Cerrar menú">×</button>
  {links.map((l) => (
    <a href={l.href} class="drawer-link" aria-current={active === l.key ? "page" : undefined}>{l.label}</a>
  ))}
  <a href="tel:+582129936508" class="drawer-link">+58 212 993·65·08</a>
  <a href="/contacto" class="btn btn--primary btn--block drawer-link">Solicitar cotización</a>
</aside>

<style>
  .brand-logo {
    display: flex;
    align-items: center;
  }
  .brand-logo :global(svg) {
    height: 68px;
    width: auto;
  }

  /* Estado base — oculto, desplazado hacia arriba */
  :global(.brand-navbar-text) {
    display: block;
    opacity: 0;
    transform: scale(0.98) translateY(-8px);
    transition: opacity 0.42s cubic-bezier(0.2, 0.9, 0.2, 1),
                transform 0.42s cubic-bezier(0.2, 0.9, 0.2, 1);
    font-family: 'Galano Grotesque', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -2px;
    color: #FFFFFF;
    white-space: nowrap;
    pointer-events: none;
  }

  /* Estado scrolled — visible, en posición */
  :global(.site-header.scrolled .brand-navbar-text) {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  /* Venezuela — menor opacidad */
  :global(.brand-navbar-text .venezuela) {
    color: rgba(255, 255, 255, 0.5);
    font-weight: 400;
  }
</style>

<script is:inline>
  (function () {
    const burger = document.getElementById("burger");
    const drawer = document.getElementById("drawer");
    const overlay = document.getElementById("drawerOverlay");
    const close = document.getElementById("drawerClose");
    if (burger && drawer && overlay && close) {
      const open = () => {
        drawer.classList.add("open");
        overlay.classList.add("open");
        document.body.style.overflow = "hidden";
      };
      const shut = () => {
        drawer.classList.remove("open");
        overlay.classList.remove("open");
        document.body.style.overflow = "";
      };
      burger.addEventListener("click", open);
      close.addEventListener("click", shut);
      overlay.addEventListener("click", shut);
      document.querySelectorAll(".drawer-link").forEach((a) => a.addEventListener("click", shut));
    }
  })();

  window.addEventListener('scroll', function () {
    var header = document.querySelector('.site-header');
    if (!header) return;
    header.classList.toggle('scrolled', window.scrollY > 60);
  });
</script>
