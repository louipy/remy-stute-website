---
/* Ventaja competitiva — Home sección 04 (banda verde oscuro). */
const cards = [
  { n: "01", tag: "Operativo", title: "Stock local en el país", desc: "142 toneladas rotativas en almacén propio. Despacho a planta en 24–72 horas para los 5 productos Fase 1." },
  { n: "02", tag: "Contractual", title: "Representación exclusiva regional", desc: "Únicos canalizadores autorizados de Addcon, Yipin y Minerales Industriales en territorio venezolano." },
  { n: "03", tag: "Incluido", title: "Asesoría técnica incluida", desc: "Cada cotización viene con análisis de aplicación. Sin cargo, antes de la orden, por ingeniero formulador." },
  { n: "04", tag: "Incluido", title: "Muestras gratuitas previas", desc: "Hasta 1 kg gratuito por producto para piloto productivo. Certificado de análisis del lote acompaña la muestra." },
];
---

<section class="ventaja">
  <div class="wrap">
    <header class="ventaja__head reveal">
      <p class="eyebrow eyebrow--dark">
        <span class="num">04</span>
        <span class="line"></span>
        <span>Ventaja competitiva · por qué Remy &amp; Stute</span>
      </p>
      <h2 class="ventaja__title">
        30 años siendo <span class="y">la mejor opción.</span>
      </h2>
    </header>

    <div class="ventaja__grid reveal">
      {cards.map((c) => (
        <article class="vcard">
          <div class="vcard__row">
            <span class="vcard__num">{c.n}</span>
            <span class="vcard__tag">{c.tag}</span>
          </div>
          <h3 class="vcard__title">{c.title}</h3>
          <p class="vcard__desc">{c.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ventaja { background: var(--ink); color: #fff; padding: 88px 0 96px; }
  .ventaja__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 48px;
  }
  .ventaja__title {
    margin-top: 20px;
    max-width: 760px;
    font-family: var(--display);
    font-size: clamp(32px, 3.4vw, 44px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .ventaja__title .y { color: var(--yellow); }
  .ventaja__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .vcard {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.18);
    padding: 28px;
    transition: background 160ms, border-color 160ms;
  }
  .vcard:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.32);
  }
  .vcard__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 24px;
  }
  .vcard__num { font-family: var(--num); font-size: 32px; color: var(--yellow); }
  .vcard__tag {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }
  .vcard__title {
    font-family: var(--display);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
    color: #fff;
    margin-bottom: 10px;
  }
  .vcard__desc { font-size: 13.5px; line-height: 1.65; color: rgba(255, 255, 255, 0.7); }

  @media (max-width: 980px) {
    .ventaja__grid { grid-template-columns: repeat(2, 1fr); }
    .ventaja__head { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 560px) {
    .ventaja__grid { grid-template-columns: 1fr; }
  }
</style>
