---
import sectorPintura from "../assets/Sector - pintura.webp";
import sectorCeramicas from "../assets/Sector-ceramicas.webp";
import sectorFeed from "../assets/SECTOR-FEED.webp";
import sectorConstruccion from "../assets/SECTOR-CONSTRUCCION.webp";

const sectores = [
  {
    name: "Cerámicas",
    photo: sectorCeramicas.src,
    alt: "Sector cerámicas — producción industrial",
  },
  {
    name: "Construcción",
    photo: sectorConstruccion.src,
    alt: "Sector construcción — materiales industriales",
  },
  {
    name: "Pinturas",
    photo: sectorPintura.src,
    alt: "Sector pinturas — pigmentos industriales",
  },
  {
    name: "Feed",
    photo: sectorFeed.src,
    alt: "Sector feed — alimento balanceado industrial",
  },
  {
    name: "Industrial",
    photo: "https://images.unsplash.com/photo-1660448059127-c332105d7a29?fm=jpg&q=60&w=1400&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8M3x8Y2hlbWljYWwlMjBpbmR1c3RyeXxlbnwwfHwwfHx8MA%3D%3D",
    alt: "Planta química industrial",
  },
  {
    name: "Aminoácidos",
    photo: "https://images.unsplash.com/photo-1707944745860-4615eb585a41?fm=jpg&q=60&w=1400&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8bGFib3JhdG9yeSUyMHJlc2VhcmNofGVufDB8fDB8fHww",
    alt: "Laboratorio de análisis industrial",
  },
];
---

<section class="sectores">
  <div class="wrap">

    <!-- ── CONGELADO: header aprobado, no tocar ── -->
    <header class="sectores__head reveal">
      <p class="eyebrow">
        <span class="line"></span>
        <span>Servicios que ofrecemos · cobertura nacional</span>
      </p>
      <h2 class="sectores__title">
        6 sectores donde nuestra materia prima
        <span class="g">ya está en planta.</span>
      </h2>
    </header>

    <!-- ── Grid de sectores ── -->
    <div class="sectores__grid reveal">
      {sectores.map((s) => (
        <a class="sector" href={`/productos?sector=${s.name}`}>
          <div class="sector__photo">
            <img src={s.photo} alt={s.alt} loading="lazy" />
          </div>
          <div class="sector__overlay">
            <span class="sector__overline">Sector</span>
            <h3 class="sector__name">
              {s.name}
              <span class="sector__accent"></span>
            </h3>
          </div>
          <div class="sector__arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </a>
      ))}
    </div>

    <!-- ── CTA ── -->
    <div class="sectores__cta">
      <a href="/productos" class="sectores-cta">
        Ver catálogo completo
        <span class="sectores-cta__arrow" aria-hidden="true">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  /* ── Sección contenedor ─────────────────────────────────────── */
  .sectores {
    background: var(--cream);
    border-bottom: 1px solid var(--border);
    padding: 0 0 96px;
  }

  /* ── Cabecera de sección ─────────────────────────────────────── */
  .sectores__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 44px;
    margin-bottom: 48px;
    background: #0A2418;
    padding: 56px var(--pad) 56px;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    padding-left: calc(50vw - 50% + var(--pad));
    padding-right: calc(50vw - 50% + var(--pad));
    box-shadow:
      inset 0 2px 6px rgba(0, 0, 0, 0.88),
      inset 0 10px 28px rgba(0, 0, 0, 0.65),
      inset 0 28px 64px rgba(0, 0, 0, 0.38);
  }
  .sectores__head .eyebrow { color: #CBFF00; }
  .sectores__head .eyebrow .line { background: #CBFF00; }
  .sectores__title {
    margin-top: 0;
    max-width: 760px;
    font-family: var(--display);
    font-size: clamp(38px, 4vw, 56px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: #fff;
  }
  .sectores__title .g { color: #C8F04D; }

  /* ── Grid — 12 columnas asimétricas (dynamic layout) ────────── */
  .sectores__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 16px;
  }

  /* Fila 1: 5 + 4 + 3 */
  .sector:nth-child(1) { grid-column: span 5; min-height: 380px; }
  .sector:nth-child(2) { grid-column: span 4; min-height: 380px; }
  .sector:nth-child(3) { grid-column: span 3; min-height: 380px; }
  /* Fila 2: 3 + 5 + 4 */
  .sector:nth-child(4) { grid-column: span 3; min-height: 340px; }
  .sector:nth-child(5) { grid-column: span 5; min-height: 340px; }
  .sector:nth-child(6) { grid-column: span 4; min-height: 340px; }

  /* Nombre escala con el ancho de la tarjeta */
  .sector:nth-child(1) .sector__name,
  .sector:nth-child(5) .sector__name { font-size: 26px; }
  .sector:nth-child(2) .sector__name,
  .sector:nth-child(6) .sector__name { font-size: 22px; }
  .sector:nth-child(3) .sector__name,
  .sector:nth-child(4) .sector__name { font-size: 20px; }

  /* ── Card de sector ─────────────────────────────────────────── */
  .sector {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    min-height: 340px;
    cursor: pointer;
    text-decoration: none;
    display: block;
    box-shadow: 0 2px 8px rgba(0, 75, 36, 0.04), 0 0 0 1px var(--border);
    transition:
      transform 0.45s cubic-bezier(0.19, 1, 0.22, 1),
      box-shadow 0.45s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .sector:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0, 75, 36, 0.12),
                0 8px 20px rgba(0, 75, 36, 0.08);
  }

  /* ── Foto de fondo completo ─────────────────────────────────── */
  .sector__photo {
    position: absolute;
    inset: 0;
  }
  .sector__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .sector:hover .sector__photo img { transform: scale(1.06); }

  /* ── Overlay gradiente inferior ─────────────────────────────── */
  .sector__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 40px 28px 24px;
    background: linear-gradient(
      to top,
      rgba(0, 30, 14, 0.85) 0%,
      rgba(0, 30, 14, 0.4) 55%,
      transparent 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    transition: padding-bottom 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .sector:hover .sector__overlay { padding-bottom: 30px; }

  /* ── Overline — aparece en hover ─────────────────────────────── */
  .sector__overline {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #CBFF00;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.4s cubic-bezier(0.19, 1, 0.22, 1),
      transform 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .sector:hover .sector__overline {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Nombre del sector ──────────────────────────────────────── */
  .sector__name {
    font-family: var(--display);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #fff;
    position: relative;
    display: inline-block;
  }

  /* ── Barra de acento amarilla ────────────────────────────────── */
  .sector__accent {
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 0;
    height: 3px;
    background: #CBFF00;
    border-radius: 2px;
    transform-origin: left;
    transition: width 0.35s ease-out;
  }
  .sector:hover .sector__accent { width: 100%; }

  /* ── Botón flecha circular — aparece en hover ────────────────── */
  .sector__arrow {
    position: absolute;
    bottom: 38px;
    right: 24px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    opacity: 0;
    transform: scale(0.75);
    transition:
      opacity 0.3s ease-out,
      transform 0.3s ease-out,
      background 0.4s cubic-bezier(0.19, 1, 0.22, 1),
      color 0.4s cubic-bezier(0.19, 1, 0.22, 1);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .sector:hover .sector__arrow {
    opacity: 1;
    transform: scale(1);
    background: #CBFF00;
    color: var(--ink);
  }

  /* ── CTA "Ver catálogo completo" ─────────────────────────────── */
  .sectores__cta {
    display: flex;
    justify-content: center;
    margin-top: 56px;
  }
  .sectores-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    font-family: var(--body);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 2px;
    border: 1.5px solid var(--green);
    color: var(--green);
    background: transparent;
    transition:
      background 0.35s cubic-bezier(0.19, 1, 0.22, 1),
      color 0.35s cubic-bezier(0.19, 1, 0.22, 1),
      transform 0.35s cubic-bezier(0.19, 1, 0.22, 1),
      box-shadow 0.35s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .sectores-cta:hover {
    background: var(--green);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 75, 36, 0.15);
  }
  .sectores-cta__arrow {
    display: inline-block;
    transition: transform 0.35s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .sectores-cta:hover .sectores-cta__arrow { transform: translateX(4px); }

  /* ── Reduced motion ─────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .sector,
    .sector__photo img,
    .sector__overlay,
    .sector__overline,
    .sector__accent,
    .sector__arrow,
    .sectores-cta,
    .sectores-cta__arrow {
      transition: none;
    }
    .sector:hover { transform: none; }
    .sector:hover .sector__photo img { transform: none; }
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 980px) {
    .sectores__grid { grid-template-columns: repeat(2, 1fr); }
    .sector:nth-child(n) { grid-column: span 1; min-height: 300px; }
    .sectores__head { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 560px) {
    .sectores__grid { grid-template-columns: 1fr; }
    .sector:nth-child(n) { grid-column: span 1; min-height: 260px; }
  }
</style>
