---
/* Footer — design-reference. Dark green, 4 columnas + barra inferior.
   Datos de marcador (RIF, dirección): se confirman después. */
const year = new Date().getFullYear();

const sitemap = [
  { label: "Productos", href: "/productos" },
  { label: "Nosotros", href: "/nosotros" },
  { label: "Casos por industria", href: "/casos" },
  { label: "Recursos técnicos", href: "/recursos" },
  { label: "Contacto y cotización", href: "/contacto" },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand footer-col">
        <a href="/" class="brand">
          <span class="brand-mark">RS</span>
          <span class="brand-name">REMY &amp; STUTE</span>
        </a>
        <p class="footer-desc">
          Importador venezolano de materia prima industrial. Representante
          exclusivo de Addcon, Yipin Pigmentos y Minerales Industriales.
        </p>
      </div>

      <div class="footer-col">
        <p class="footer-col-title">Oficina · Caracas</p>
        <p>
          Av. Orinoco<br />
          Edif. Nalania<br />
          Las Mercedes, Caracas
        </p>
      </div>

      <div class="footer-col">
        <p class="footer-col-title">Contacto directo</p>
        <p>
          <a href="tel:+582129936508">+58 212 993·65·08</a><br />
          <a href="mailto:ventas@remyvenezuela.com" class="footer-mail">ventas@remyvenezuela.com</a><br />
          @remystute
        </p>
      </div>

      <div class="footer-col">
        <p class="footer-col-title">Mapa del sitio</p>
        <div class="footer-links">
          {sitemap.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} REMY &amp; STUTE C.A. · RIF J-00123456-7</span>
    </div>
  </div>
</footer>
