// Product schema (JSON-LD): un ItemList con un Product por cada ficha del catálogo.
// Da contexto semántico a Google/IA y habilita rich results de producto. Sin `offers`
// a propósito — es B2B por cotización, no hay precio público (una Offer sin precio sería
// engañosa). Las specs de la ficha se exponen como additionalProperty (PropertyValue).
const SITE = "https://remyvenezuela.com";
const productSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Catálogo de materia prima industrial — Remy & Stute C.A.",
  itemListElement: productos.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Product",
      name: p.name,
      description: p.desc,
      category: p.sector,
      image: SITE + p.photo.src,
      url: `${SITE}/productos#${p.id}`,
      ...(p.marca ? { brand: { "@type": "Brand", name: p.marca } } : {}),
      additionalProperty: p.specs.map(([name, value]) => ({
        "@type": "PropertyValue",
        name,
        value,
      })),
    },
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(productSchema)} />

<section class="pc-head">
  <div class="wrap">
    <p class="pc-eyebrow">Productos · Catálogo</p>
    <h1 class="pc-title">
      Materias primas industriales
    </h1>
  </div>
</section>

<section class="pc-filters">
  <div class="wrap">
    <div class="pc-filter-grid">
      <div class="pc-filter-row">
        <span class="pc-filter-label">Industria</span>
        <div class="pc-chips" data-group="sector">
          {sectores.map((s, i) => (
            <button type="button" class="chip" data-value={s} aria-pressed={i === 0 ? "true" : "false"}>{s}</button>
          ))}
        </div>
      </div>
      <div class="pc-filter-row">
        <span class="pc-filter-label">Marca</span>
        <div class="pc-chips" data-group="marca">
          {marcas.map((m, i) => (
            <button type="button" class="chip" data-value={m} aria-pressed={i === 0 ? "true" : "false"}>{m}</button>
          ))}
        </div>
      </div>
      <span class="pc-count" id="pcCount">22 de 22 resultados</span>
    </div>
  </div>
</section>

<section class="pc-table-wrap">
  <div class="wrap">
    <div class="pc-table">
      <div class="pc-row pc-row--head">
        <span>#</span>
        <span>Producto / Aplicación</span>
        <span>Marca</span>
        <span>Industria</span>
        <span></span>
      </div>
      <div id="pcRows">
        {productos.map((p, i) => (
          <article class="pc-row pc-prod" data-sector={p.sector} data-marca={p.marca ?? ""}>
            <span class="pc-num">{String(i + 1).padStart(2, "0")}</span>
            <div class="pc-prod-main">
              <h3 class="pc-prod-name">{p.name}</h3>
              <p class="pc-prod-desc">{p.rowDesc}</p>
            </div>
            <div class="pc-prod-marca">{p.marca ?? "—"}</div>
            <div class="pc-prod-sector">
              {p.sector}
            </div>
            <div class="pc-prod-actions">
              <button type="button" class="btn btn--primary btn--sm btn--block" data-ficha-open={p.id}>
                Ficha
              </button>
              <a href="/contacto" class="btn btn--outline btn--sm btn--block">Solicitar muestra</a>
            </div>
          </article>
        ))}
      </div>
      <p class="pc-empty" id="pcEmpty" hidden>
        Ningún producto coincide con el filtro. Escríbanos y le conseguimos la
        materia prima que necesita.
      </p>
    </div>
  </div>
</section>

<!-- Ficha técnica — un modal por producto. El botón "Ficha" (data-ficha-open=id)
     abre el modal con id="ficha-<id>". Contenido 100% desde el array `productos`. -->
{productos.map((p) => (
  <div class="pc-modal" id={`ficha-${p.id}`} hidden>
    <div class="pc-modal__scrim" data-ficha-close></div>
    <div
      class="pc-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby={`${p.id}-title`}
      tabindex="-1"
    >
      <button type="button" class="pc-modal__close" data-ficha-close aria-label="Cerrar ficha técnica">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
      <div class="pc-detail-card">
        <div class="pc-detail-media">
          <Image
            class="pc-detail-photo"
            src={p.photo}
            alt={p.alt}
            widths={[360, 560]}
            sizes="(max-width: 920px) 100vw, 470px"
            loading="lazy"
            decoding="async"
          />
          <span class="pc-detail-badge">{p.badge}</span>
        </div>
        <div class="pc-detail-body">
          {p.marca && <p class="pc-detail-brand">{p.marca}</p>}
          <h2 class="pc-detail-name" id={`${p.id}-title`}>{p.name}</h2>
          <p class="pc-detail-sku">{p.subtitle}</p>
          <p class="pc-detail-desc">{p.desc}</p>
          <div class="pc-spec">
            <p class="pc-spec-title">Especificación técnica</p>
            <table>
              <tbody>
                {p.specs.map(([k, v]) => (
                  <tr>
                    <td>{k}</td>
                    <td>{v}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="pc-detail-actions">
            <a href="/contacto" class="btn btn--primary">
              Solicitar cotización
              <i data-lucide="arrow-right"></i>
            </a>
            <a
              href={p.pdf.href}
              class="btn btn--outline"
              download={p.pdf.href.split('/').pop()}
            >Descargar ficha ({p.pdf.label ?? 'PDF'} · {p.pdf.size})</a>
          </div>
        </div>
      </div>
    </div>
  </div>
))}

<style>
  /* Cabecera */
  .pc-head { background: var(--dark-panel-2); border-bottom: 1px solid rgba(255,255,255,0.08); padding: 56px 0 32px; }
  .pc-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lime);
  }
  .pc-title {
    margin-top: 12px;
    max-width: 980px;
    font-family: var(--display);
    font-size: clamp(34px, 4vw, 56px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: #fff;
  }

  /* Filtros */
  .pc-filters { background: var(--cream-2); border-bottom: 1px solid var(--border); padding: 20px 0; }
  .pc-filter-grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  /* Cada filtro (label + chips) ocupa su propia fila → Industria arriba,
     Marca debajo, sin que los chips se mezclen al crecer la lista de marcas. */
  .pc-filter-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .pc-filter-label {
    flex-shrink: 0;
    min-width: 64px;
    padding-top: 8px; /* alinea el label con la primera fila de chips */
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pc-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    font-family: var(--body);
    font-size: 12px;
    font-weight: 500;
    color: var(--text);
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 6px 12px;
    cursor: pointer;
    transition: background 140ms, color 140ms, border-color 140ms;
  }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-pressed="true"] { background: var(--ink); color: #fff; border-color: var(--ink); }
  .pc-count {
    align-self: flex-end;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text);
  }

  /* Tabla */
  .pc-table-wrap { background: var(--cream); padding: 32px 0 64px; }
  .pc-table { background: var(--white); border: 1px solid var(--border); }
  /* Solo ~5 productos visibles; el resto se ve deslizando dentro del contenedor.
     Así el catálogo crece sin alargar la página. La cabecera queda fija arriba. */
  #pcRows {
    max-height: 560px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--border-2) var(--cream-2);
  }
  #pcRows::-webkit-scrollbar { width: 8px; }
  #pcRows::-webkit-scrollbar-track { background: var(--cream-2); }
  #pcRows::-webkit-scrollbar-thumb { background: var(--border-2); border-radius: 4px; }
  #pcRows::-webkit-scrollbar-thumb:hover { background: var(--muted); }
  .pc-row {
    display: grid;
    grid-template-columns: 60px minmax(0, 1.7fr) 1fr 1fr 210px;
    gap: 24px;
    align-items: center;
    padding: 24px;
    border-bottom: 1px solid var(--border);
  }
  .pc-row:last-child { border-bottom: 0; }
  .pc-row--head {
    padding: 14px 24px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--dark-panel-2);
    color: #C8F04D;
  }
  .pc-prod.is-hidden { display: none; }
  .pc-num {
    font-family: var(--num);
    font-size: 32px;
    color: var(--yellow);
    line-height: 1;
    background: var(--ink);
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: -24px 0 -24px -24px;
    padding: 24px 16px;
  }
  .pc-prod-name {
    font-family: var(--display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .pc-prod-desc { margin-top: 4px; font-size: 12.5px; line-height: 1.5; color: var(--text); }
  .pc-prod-marca { font-size: 13px; font-weight: 500; color: var(--ink); }
  .pc-prod-sector { font-size: 13px; color: var(--text); }
  .pc-prod-actions { display: flex; flex-direction: column; gap: 8px; }
  .pc-empty {
    padding: 56px 24px;
    text-align: center;
    color: var(--text);
    font-size: 14px;
  }

  /* ── Ficha técnica — modal ─────────────────────────────────────
     Overlay centrado que opaca el fondo para enfocar la ficha.
     El contenido (.pc-detail-card) es la antigua "Vista detalle".
     Animación fluida: solo opacity/transform. Entrada ease-out
     ~300ms; salida ease-in ~180ms (más rápida = más responsiva). */
  .pc-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 24px;
  }
  .pc-modal[hidden] { display: none; }
  .pc-modal__scrim {
    position: absolute;
    inset: 0;
    background: rgba(10, 15, 13, 0.62);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 180ms ease-in;
  }
  .pc-modal__dialog {
    position: relative;
    width: 100%;
    max-width: 940px;
    max-height: min(90vh, 90dvh);
    overflow-y: auto;
    background: var(--white);
    border-radius: 14px;
    box-shadow: 0 24px 80px rgba(10, 15, 13, 0.45), 0 4px 16px rgba(10, 15, 13, 0.2);
    opacity: 0;
    transform: translateY(16px) scale(0.985);
    transition: opacity 180ms ease-in, transform 180ms ease-in;
    -webkit-overflow-scrolling: touch;
  }
  .pc-modal__dialog:focus { outline: none; }
  .pc-modal.is-open .pc-modal__scrim {
    opacity: 1;
    transition: opacity 260ms ease-out;
  }
  .pc-modal.is-open .pc-modal__dialog {
    opacity: 1;
    transform: none;
    transition: opacity 300ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 340ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pc-modal__close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease;
  }
  .pc-modal__close:hover { background: var(--ink); color: #fff; }
  .pc-modal__close:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .pc-modal__close svg { width: 20px; height: 20px; }
  /* Dentro del modal la tarjeta hereda el radio del diálogo, sin borde propio */
  .pc-modal__dialog .pc-detail-card { border: 0; border-radius: 14px; overflow: hidden; }

  :global(body.pc-modal-open) { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .pc-modal__scrim,
    .pc-modal__dialog { transition: none; }
  }

  /* Tarjeta de la ficha (antigua "Vista detalle") */
  .pc-detail-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    background: var(--white);
    border: 1px solid var(--border-2);
  }
  .pc-detail-media {
    position: relative;
    min-height: 420px;
    border-right: 1px solid var(--border);
    background: var(--cream-2);
    overflow: hidden;
  }
  .pc-detail-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }
  .pc-detail-badge {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 1;
    padding: 6px 10px;
    background: rgba(10, 36, 24, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }
  .pc-detail-body { padding: 40px; }
  .pc-detail-brand {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 8px;
  }
  .pc-detail-name {
    font-family: var(--display);
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .pc-detail-sku {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .pc-detail-desc { font-size: 14.5px; line-height: 1.7; color: var(--text); margin-bottom: 28px; }
  .pc-spec { padding-top: 20px; border-top: 1px solid var(--border); }
  .pc-spec-title {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .pc-spec table { width: 100%; border-collapse: collapse; }
  .pc-spec td {
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }
  .pc-spec td:first-child {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  .pc-spec td:last-child { text-align: right; font-weight: 600; color: var(--ink); }
  .pc-detail-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px; }

  @media (max-width: 920px) {
    /* ── Catálogo en tarjetas (móvil/tablet) ──────────────────────
       Cada producto es una tarjeta: número como badge contenido
       (sin el sangrado full-bleed del desktop, que solapaba el
       nombre), nombre + descripción, meta etiquetada y acciones
       táctiles. */
    .pc-row--head { display: none; }
    .pc-row {
      grid-template-columns: 44px 1fr;
      column-gap: 14px;
      row-gap: 0;
      align-items: start;
      padding: 20px;
    }
    /* Número como badge contenido — fin de la colisión con el nombre */
    .pc-num {
      grid-column: 1;
      grid-row: 1;
      margin: 0;
      padding: 0;
      width: 44px;
      height: 44px;
      border-radius: 6px;
      font-size: 20px;
      align-self: start;
    }
    .pc-prod-main { grid-column: 2; grid-row: 1; }
    .pc-prod-name { font-size: 18px; }
    .pc-prod-desc { font-size: 13px; }

    /* Meta etiquetada: Marca / Industria */
    .pc-prod-marca,
    .pc-prod-sector {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
    }
    .pc-prod-marca {
      grid-row: 2;
      margin-top: 16px;
      padding-top: 14px;
      border-top: 1px solid var(--border);
    }
    .pc-prod-sector { grid-row: 3; margin-top: 10px; }
    .pc-prod-marca::before,
    .pc-prod-sector::before {
      flex-shrink: 0;
      min-width: 70px;
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .pc-prod-marca::before  { content: "Marca"; }
    .pc-prod-sector::before { content: "Industria"; }

    /* Acciones táctiles (mín. 44px) */
    .pc-prod-actions {
      grid-column: 1 / -1;
      grid-row: 4;
      flex-direction: row;
      gap: 10px;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }
    .pc-prod-actions .btn { flex: 1; min-height: 44px; }

    /* Filtros más cómodos al tacto */
    .chip { min-height: 40px; padding: 9px 14px; font-size: 13px; }

    /* Ficha técnica — modal + tarjeta en una columna */
    .pc-modal { padding: 12px; }
    .pc-detail-card { grid-template-columns: 1fr; }
    .pc-detail-media { min-height: 260px; border-right: 0; border-bottom: 1px solid var(--border); }
    .pc-detail-body { padding: 28px; }
  }
</style>

<script is:inline>
  (function () {
    const rowsWrap = document.getElementById("pcRows");
    const empty = document.getElementById("pcEmpty");
    const count = document.getElementById("pcCount");
    if (!rowsWrap || !empty || !count) return;

    const rows = Array.from(rowsWrap.querySelectorAll(".pc-prod"));
    const state = { sector: "Todos", marca: "Todas" };

    function apply() {
      let visible = 0;
      rows.forEach((row) => {
        const okSector = state.sector === "Todos" || row.dataset.sector === state.sector;
        const okMarca = state.marca === "Todas" || row.dataset.marca === state.marca;
        const show = okSector && okMarca;
        row.classList.toggle("is-hidden", !show);
        if (show) {
          visible++;
          // El número enumera las opciones visibles (1..N), no es fijo por producto.
          const num = row.querySelector(".pc-num");
          if (num) num.textContent = String(visible).padStart(2, "0");
        }
      });
      empty.hidden = visible > 0;
      count.textContent = visible + " de " + rows.length + " resultados";
      rowsWrap.scrollTop = 0;
    }

    document.querySelectorAll(".pc-chips").forEach((group) => {
      const key = group.dataset.group;
      group.addEventListener("click", (e) => {
        const btn = e.target.closest(".chip");
        if (!btn) return;
        group.querySelectorAll(".chip").forEach((c) => {
          c.setAttribute("aria-pressed", c === btn ? "true" : "false");
        });
        state[key] = btn.dataset.value;
        apply();
      });
    });

    // Activate filter from URL param (e.g. /productos?sector=Cerámicas)
    const sectorParam = new URLSearchParams(window.location.search).get("sector");
    if (sectorParam) {
      const chip = document.querySelector('.pc-chips[data-group="sector"] .chip[data-value="' + sectorParam + '"]');
      if (chip) {
        document.querySelectorAll('.pc-chips[data-group="sector"] .chip').forEach((c) => {
          c.setAttribute("aria-pressed", c === chip ? "true" : "false");
        });
        state.sector = sectorParam;
        apply();
      }
    }
  })();
</script>

<script is:inline>
  /* Ficha técnica — controlador de modales (uno por producto).
     - [data-ficha-open="<id>"] abre #ficha-<id>.
     - Cierra con la X, el scrim o Escape.
     - Bloquea el scroll del fondo, atrapa el foco dentro del diálogo
       y lo devuelve al disparador al cerrar.
     - Respeta prefers-reduced-motion (cierra sin esperar la animación). */
  (function () {
    const modals = Array.prototype.slice.call(document.querySelectorAll(".pc-modal"));
    if (!modals.length) return;
    const FOCUSABLE =
      'a[href], button:not([disabled]), input:not([disabled]), textarea, [tabindex]:not([tabindex="-1"])';
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let current = null; // modal abierto actualmente
    let lastFocused = null;
    let closeTimer = null;

    function open(modal, trigger) {
      if (!modal) return;
      clearTimeout(closeTimer);
      current = modal;
      lastFocused = trigger || document.activeElement;
      modal.hidden = false;
      document.body.classList.add("pc-modal-open");
      void modal.offsetWidth; // fuerza reflow para que la transición de entrada corra
      modal.classList.add("is-open");
      const closeBtn = modal.querySelector(".pc-modal__close");
      const dialog = modal.querySelector(".pc-modal__dialog");
      (closeBtn || dialog).focus();
    }

    function close() {
      if (!current) return;
      const modal = current;
      current = null;
      modal.classList.remove("is-open");
      document.body.classList.remove("pc-modal-open");
      const finish = function () {
        modal.hidden = true;
        if (lastFocused && typeof lastFocused.focus === "function") lastFocused.focus();
      };
      if (reduceMotion.matches) finish();
      else closeTimer = setTimeout(finish, 200);
    }

    document.querySelectorAll("[data-ficha-open]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        open(document.getElementById("ficha-" + btn.getAttribute("data-ficha-open")), btn);
      });
    });
    modals.forEach(function (modal) {
      modal.querySelectorAll("[data-ficha-close]").forEach(function (el) {
        el.addEventListener("click", close);
      });
    });

    document.addEventListener("keydown", function (e) {
      if (!current) return;
      if (e.key === "Escape") {
        e.preventDefault();
        close();
        return;
      }
      if (e.key === "Tab") {
        const dialog = current.querySelector(".pc-modal__dialog");
        const items = Array.prototype.slice
          .call(dialog.querySelectorAll(FOCUSABLE))
          .filter(function (el) {
            return el.offsetParent !== null;
          });
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>
