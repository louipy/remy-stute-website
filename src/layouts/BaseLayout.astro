---
import "@styles/global.css";
import FlagRibbon from "@components/FlagRibbon.astro";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  theme?: "light" | "dark";
  active?: "inicio" | "productos" | "nosotros" | "contacto";
}

const {
  title = "Remy & Stute C.A. — Materia Prima Industrial Venezuela",
  description = "Importador venezolano de materia prima industrial con 30 años de trayectoria. Representante exclusivo de Addcon, Yipin Pigmentos y Minerales Industriales en Venezuela.",
  canonical,
  ogImage,
  noindex = false,
  theme = "light",
  active,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImageURL = ogImage ?? new URL("og-default.jpg", Astro.site ?? "https://remyvenezuela.com/").toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Oswald:wght@400;500&family=Plus+Jakarta+Sans:wght@700;800&display=swap"
      rel="stylesheet"
    />

    <script src="https://unpkg.com/lucide@latest" defer is:inline></script>

    {/* Consent Mode — defaults denegados ANTES de que GTM cargue (Fase 5) */}
    <script is:inline>
window.dataLayer=window.dataLayer||[];
function gtag(){dataLayer.push(arguments);}
gtag('consent','default',{
  ad_storage:'denied',
  analytics_storage:'denied',
  ad_user_data:'denied',
  ad_personalization:'denied',
  wait_for_update:500
});
    </script>

    {/* Google Tag Manager — Main Thread (R5). NO Partytown. */}
    <script is:inline>
(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-M9WVFZ9M');
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": ["LocalBusiness", "WholesaleStore"],
          "@id": "https://remyvenezuela.com/#business",
          "name": "Remy & Stute C.A.",
          "description": "Importador venezolano de materia prima industrial con 30 años de trayectoria. Representante exclusivo de Addcon, Yipin Pigmentos y Minerales Industriales en Venezuela.",
          "url": "https://remyvenezuela.com",
          "telephone": "+58-412-260-0046",
          "email": "info@remyvenezuela.com",
          "taxID": "J-30298111-5",
          "foundingDate": "1995",
          "logo": {
            "@type": "ImageObject",
            "@id": "https://remyvenezuela.com/#logo",
            "url": "https://remyvenezuela.com/favicon.svg",
            "contentUrl": "https://remyvenezuela.com/favicon.svg"
          },
          "image": "https://remyvenezuela.com/og-default.jpg",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Caracas",
            "addressRegion": "Distrito Capital",
            "addressCountry": "VE"
          },
          "areaServed": {
            "@type": "Country",
            "name": "Venezuela"
          },
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+58-412-260-0046",
            "email": "info@remyvenezuela.com",
            "contactType": "sales",
            "availableLanguage": "Spanish"
          },
          "sameAs": [],
          "knowsAbout": [
            "Materia prima industrial",
            "Pigmentos industriales",
            "Aditivos para construcción",
            "Minerales industriales",
            "Industria cerámica Venezuela",
            "Industria pinturas Venezuela",
            "Industria petrolera Venezuela",
            "Industria alimento animal Venezuela"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://remyvenezuela.com/#website",
          "url": "https://remyvenezuela.com",
          "name": "Remy & Stute C.A.",
          "description": "Importador venezolano de materia prima industrial",
          "inLanguage": "es-VE",
          "publisher": { "@id": "https://remyvenezuela.com/#business" },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": "https://remyvenezuela.com/productos?sector={search_term_string}"
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} />

    <slot name="head" />
  </head>

  <body data-theme={theme}>
    {/* Google Tag Manager noscript — fallback sin JS */}
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M9WVFZ9M"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <FlagRibbon />
    <Navbar active={active} />

    <main class:list={[{ "main--offset": active !== "inicio" }]}>
      <slot />
    </main>

    <Footer />

    <a
      href="https://wa.me/584122600046"
      class="wa-float"
      target="_blank"
      rel="noopener"
      aria-label="Escribir por WhatsApp"
    >
      <i data-lucide="message-circle"></i>
    </a>

    <script is:inline>
      function initLucide() {
        if (typeof lucide !== "undefined") lucide.createIcons();
      }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initLucide);
      } else {
        initLucide();
      }

      // Scroll reveal
      const revealEls = document.querySelectorAll(".reveal");
      if (revealEls.length && "IntersectionObserver" in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("visible");
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        revealEls.forEach((el) => obs.observe(el));
      }
    </script>
  </body>
</html>
